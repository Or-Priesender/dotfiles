# Never commit actual secrets
.secrets

# Local overrides and backups
*.local
*.backup
*.bak
*~

# OS and editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Runtime state
*.socket
*.lock

# tmux plugins (installed by TPM)
tmux/.config/tmux/plugins/

# Rex runtime state (last session for prefix+;)
rex/.config/rex/.session-state
